{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "src/lib/**/*.ts", "src/types/incense.ts", "src/types/global.d.ts"]
}
